# DashKit project-configuration menu.
#
# CONFIG_DASHKIT_TESLA_BLE gates the Tesla BLE vehicle-command client: the
# CENTRAL role connects to the car (VCSEC handshake + persistent GET_STATUS
# poll), backed by main/tesla/ and the tesla-protocol component. There is no
# observer/scan path — the app provisions the car's VIN + BLE address over the
# app-channel service. Disabling the option removes the tesla/ modules and the
# BLE central role from the build, so the stack stays exactly as a
# dashboard-only device expects it.
menu "DashKit"
    config DASHKIT_TESLA_BLE
        bool "Tesla BLE vehicle-command client"
        depends on BT_ENABLED && BT_NIMBLE_ENABLED
        select BT_NIMBLE_ROLE_CENTRAL
        default y
        help
            Adds the Tesla BLE vehicle-command client (connect, VCSEC
            handshake, persistent GET_STATUS poll) driven entirely from the
            phone app. Disabling removes the tesla/ modules and the BLE
            central role from the build.

    config DASHKIT_BTHOME
        bool "BTHome button listener (Shelly BLU)"
        depends on BT_ENABLED && BT_NIMBLE_ENABLED
        select BT_NIMBLE_ROLE_OBSERVER
        default n
        help
            Passive scan for BTHome v2 advertisements (Shelly BLU buttons),
            mapping button events to vehicle controls. Work in progress.

    config DASHKIT_BTHOME_ALLOWED
        string "Allowed BTHome button addresses"
        depends on DASHKIT_BTHOME
        default ""
        help
            Comma-separated addresses of the buttons allowed to trigger
            vehicle controls, as the log prints them ("BTHome device
            AA:BB:CC:DD:EE:FF seen"). BTHome advertisements are unauthenticated,
            so events from any other device are ignored. Empty: no button
            triggers anything; nearby devices are only logged.

    config DASHKIT_CAN_STREAM_ALL
        bool "CAN stream-all: accept every frame, route in software"
        default n
        help
            Default (off): one exact-match hardware filter per CAN id listed in
            dbc/used_messages.txt, 32 per bus at most.

            On: the CAN controllers accept every frame. Ids the firmware itself
            reads or injects go to a dedicated fast-lane FIFO that is always
            drained first; everything else goes to bulk FIFOs read in chunks.
            Which frames reach the app is decided in software, so the app can
            subscribe to any id (CAN filter characteristic) without a firmware
            change and without the 32-id limit. Statistics are logged every
            5 s ("stream:" and "route:" lines).

            Experimental: validate vehicle controls on the car before use.
endmenu
